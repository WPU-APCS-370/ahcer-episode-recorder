rules_version = '2';

// TEMPORARY development unblock, deployed only to the ahcer-dev project.
//
// This intentionally does NOT scope access by role or ownership (admin,
// PI, parent/child) -- it only requires that a request is authenticated.
// Any signed-in user can read or write any document. That's acceptable for
// ahcer-dev, which has no real data, but must never be deployed to
// production (wpu-ahcer).
//
// Always deploy explicitly: `firebase deploy --only firestore:rules --project ahcer-dev`
// (or `npm run deploy-rules-dev`). Never run a bare `firebase deploy` in
// this repo -- the default project alias is wpu-ahcer (production).
//
// The real, role-scoped rules (admin / PI / parent-child, per
// docs/ARCHITECTURE.md) with emulator-based tests are tracked in issue #46
// and should replace this file before it's ever pointed at production.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
